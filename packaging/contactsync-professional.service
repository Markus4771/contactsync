[Unit]
Description=ContactSync Professional
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contactsync
Group=contactsync
Environment=CONTACTSYNC_DATA_DIR=/var/lib/contactsync-professional
Environment=CONTACTSYNC_PORT=8000
ExecStart=/opt/contactsync-professional/venv/bin/contactsync-professional
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/contactsync-professional

[Install]
WantedBy=multi-user.target
